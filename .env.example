# Port the app listens on inside the container. The compose file maps this to
# a host port (default 3200) — you shouldn't need to change this.
PORT=3000

# Set this if something sits in front of Kinboard (Caddy, nginx, Nginx Proxy
# Manager, Traefik, a Cloudflare Tunnel) so it can see the real client IP.
#   TRUST_PROXY=1            one proxy hop — the right answer for almost everyone
#   TRUST_PROXY=true         trust the whole X-Forwarded-For chain
#   TRUST_PROXY=10.0.0.0/8   trust specific proxy addresses
# OFF by default on purpose: trusting X-Forwarded-For without a real proxy in
# front lets anyone forge it and bypass the login rate limiter.
# TRUST_PROXY=1

# Set to true once you serve Kinboard over HTTPS, to mark the session cookie
# HTTPS-only. Leave OFF for plain-HTTP LAN use — with it on, the browser accepts
# the cookie at login and then refuses to send it back, and you can never log in.
# SECURE_COOKIES=true

# Where the "Support Kinboard" button on the settings page points. Defaults to
# the project's Ko-fi page. Set it to an empty value to hide the button.
# DONATE_URL=

# Optional: overrides the auto-generated session-signing secret. You don't
# need to set this — Kinboard generates and persists one on first run — but
# you can pin it here if you'd rather manage it yourself (e.g. to keep
# sessions valid across a database restore).
# SESSION_SECRET=

# ── Notifications ───────────────────────────────────────────────────────────
# Push notifications (per-device, configured in Settings) need NO setup here —
# Kinboard generates its own keys on first use. They do require Kinboard to be
# served over HTTPS, because browsers refuse Web Push on plain HTTP. If you're
# running on a bare LAN address, use the webhook below instead.

# Hour of the day (0-23, in your household's timezone) to send the daily digest.
# DIGEST_HOUR=7

# Optional webhook — the fallback that works over plain HTTP, and the easiest
# path if you'd rather not set up HTTPS. Notifications are also sent here, for
# the household as a whole (no per-person routing).
#   ntfy:    https://ntfy.sh/your-secret-topic-name
#   discord: a channel webhook URL
#   slack:   an incoming-webhook URL
#   json:    any endpoint; receives {"title": "...", "body": "..."}
# WEBHOOK_URL=
# WEBHOOK_TYPE=ntfy

# Contact address embedded in push messages, which push services use to reach
# an operator about problem traffic. Nothing is ever sent to it.
# VAPID_SUBJECT=mailto:you@example.com
